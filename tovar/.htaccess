Options -Indexes

<FilesMatch "(?i)\.(php|phtml|phar|php[0-9]|cgi|pl|py|sh)(\.|$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

RemoveHandler .php .phtml .phar .php3 .php4 .php5 .php7 .php8
RemoveType .php .phtml .phar .php3 .php4 .php5 .php7 .php8
AddType text/plain .php .phtml .phar .php3 .php4 .php5 .php7 .php8
